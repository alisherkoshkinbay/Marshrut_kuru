@startuml sequence-diagram
title Стратегияны ауыстыру барысы

skinparam shadowing false
actor Пайдаланушы as U
participant Main
participant Navigator
participant "WalkingStrategy" as W
participant "CarStrategy" as C

U -> Main : қайдан, қайда, қашықтық
Main -> Navigator : new Navigator(new WalkingStrategy())

U -> Main : "2" (Көлікпен)
Main -> Navigator : setStrategy(new CarStrategy())
Main -> Navigator : buildRoute(from, to, km)
Navigator -> C : buildRoute(from, to, km)
C --> Navigator : RouteResult
Navigator --> Main : RouteResult
Main --> U : уақыт, құны

U -> Main : "1" (Жаяу)
Main -> Navigator : setStrategy(new WalkingStrategy())
Main -> Navigator : buildRoute(from, to, km)
Navigator -> W : buildRoute(from, to, km)
W --> Navigator : RouteResult
Navigator --> Main : RouteResult
Main --> U : уақыт, құны

@enduml
